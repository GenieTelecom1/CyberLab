<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox xmlns="[suspicious link removed]" xmlns:fx="[suspicious link removed]" prefHeight="650.0" prefWidth="850.0" spacing="20.0" style="-fx-background-color: #F8F9FA;" fx:controller="com.example.demo1.PasswordCheckerController">
    <padding>
        <Insets bottom="25.0" left="30.0" right="30.0" top="25.0" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="50.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 8, 0, 0, 2);">
            <padding>
                <Insets left="20.0" right="20.0" />
            </padding>
            <children>
                <Label text="Simulation : Password Strength Checker" style="-fx-font-weight: bold;" textFill="#2C3E50">
                    <font>
                        <Font size="20.0" />
                    </font>
                </Label>
            </children>
        </HBox>

        <VBox spacing="15.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-border-color: #E0E0E0; -fx-border-radius: 10;">
            <padding>
                <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
            </padding>
            <children>
                <Label text="Testez la robustesse de votre mot de passe en temps réel :" textFill="#34495E">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <PasswordField fx:id="txtPassword" promptText="Entrez un mot de passe à tester..." style="-fx-font-size: 15px; -fx-padding: 10; -fx-background-radius: 6; -fx-border-color: #BDC3C7; -fx-border-radius: 6;" />

                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <ProgressBar fx:id="progressScore" prefHeight="18.0" prefWidth="400.0" progress="0.0" style="-fx-accent: #E74C3C;" />
                        <Label fx:id="lblScorePercent" style="-fx-font-weight: bold;" text="0 / 100" textFill="#7F8C8D" />
                        <Label fx:id="lblNiveau" style="-fx-font-weight: bold;" text="Force : TRES FAIBLE" textFill="#E74C3C">
                            <font>
                                <Font size="15.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>
            </children>
        </VBox>

        <HBox spacing="20.0" VBox.vgrow="ALWAYS">
            <children>
                <VBox spacing="10.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-border-color: #E0E0E0; -fx-border-radius: 10;" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <children>
                        <Label style="-fx-font-weight: bold;" text="Critères validés :" textFill="#27AE60">
                            <font>
                                <Font size="15.0" />
                            </font>
                        </Label>
                        <VBox fx:id="vboxCriteres" spacing="6.0" />
                    </children>
                </VBox>

                <VBox spacing="10.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-border-color: #E0E0E0; -fx-border-radius: 10;" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <children>
                        <Label style="-fx-font-weight: bold;" text="Recommandations d'amélioration :" textFill="#D35400">
                            <font>
                                <Font size="15.0" />
                            </font>
                        </Label>
                        <VBox fx:id="vboxConseils" spacing="6.0" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>
