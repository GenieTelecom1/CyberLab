<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cyberlab.controller.HistoryController" alignment="TOP_CENTER" spacing="20" styleClass="dashboard-content">
    <HBox alignment="CENTER_LEFT">
        <Label text="CYBERLAB / HISTORIQUE" styleClass="section-label"/>
    </HBox>
    <VBox spacing="15" styleClass="card" maxWidth="750" VBox.vgrow="ALWAYS">
        <Label text="Ma progression (score en %)" styleClass="card-title"/>
        <LineChart fx:id="progressChart" prefHeight="230" minHeight="230" legendVisible="false" animated="false" createSymbols="true">
            <xAxis>
                <CategoryAxis side="BOTTOM"/>
            </xAxis>
            <yAxis>
                <NumberAxis side="LEFT" autoRanging="false" lowerBound="0" upperBound="100" tickUnit="25"/>
            </yAxis>
        </LineChart>
        <Label text="Mes quiz passés" styleClass="card-title"/>
        <TableView fx:id="historyTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="dateColumn" text="Date" prefWidth="180"/>
                <TableColumn fx:id="courseColumn" text="Cours" prefWidth="380"/>
                <TableColumn fx:id="scoreColumn" text="Score" prefWidth="120"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
        <Label fx:id="summaryLabel" text="" styleClass="section-label"/>
    </VBox>
</VBox>