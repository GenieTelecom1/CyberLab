<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      spacing="18.0" styleClass="dashboard-content"
      fx:controller="com.cyberlab.controller.PasswordCheckerController">
    <children>
        <HBox alignment="CENTER_LEFT" styleClass="card">
            <children>
                <Label text="Simulation : Password Strength Checker" styleClass="section-title" />
            </children>
        </HBox>

        <VBox spacing="12.0" styleClass="card">
            <children>
                <Label text="Testez la robustesse de votre mot de passe en temps réel." styleClass="muted" />
                <PasswordField fx:id="txtPassword" promptText="Entrez un mot de passe à tester..." />
                <HBox alignment="CENTER_LEFT" spacing="14.0">
                    <children>
                        <ProgressBar fx:id="progressScore" progress="0.0" prefWidth="400.0" />
                        <Label fx:id="lblScorePercent" text="0 / 100" styleClass="rank-score" />
                        <Label fx:id="lblNiveau" text="Force : TRÈS FAIBLE" styleClass="card-title" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <HBox spacing="18.0" VBox.vgrow="ALWAYS">
            <children>
                <VBox spacing="8.0" styleClass="card" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Critères validés :" styleClass="section-label" />
                        <VBox fx:id="vboxCriteres" spacing="6.0" />
                    </children>
                </VBox>
                <VBox spacing="8.0" styleClass="card" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Recommandations d'amélioration :" styleClass="section-label" />
                        <VBox fx:id="vboxConseils" spacing="6.0" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>