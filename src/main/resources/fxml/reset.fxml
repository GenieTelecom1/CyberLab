<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      styleClass="auth-root" fx:controller="com.cyberlab.controller.ResetPasswordController">
    <stylesheets>
        <URL value="@../css/auth.css"/>
    </stylesheets>

    <fx:include source="auth-hero.fxml"/>

    <ScrollPane HBox.hgrow="ALWAYS" fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER"
                styleClass="auth-scroll">
        <StackPane styleClass="auth-right">
            <VBox styleClass="auth-card" prefWidth="440" maxWidth="440" maxHeight="-Infinity" spacing="14">
                <HBox>
                    <Label text="NOUVEAU MOT DE PASSE" styleClass="badge"/>
                </HBox>
                <Label text="Choisissez un nouveau mot de passe" styleClass="auth-title" wrapText="true"/>
                <Label fx:id="infoLabel" styleClass="auth-subtitle" wrapText="true"/>

                <Label fx:id="successLabel" styleClass="success-label" maxWidth="Infinity" wrapText="true"/>
                <Label fx:id="errorLabel" styleClass="error-label" maxWidth="Infinity" wrapText="true"/>

                <VBox spacing="6">
                    <Label text="Code reçu par e-mail" styleClass="field-label"/>
                    <TextField fx:id="codeField" promptText="000000" styleClass="auth-field, code-field"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Nouveau mot de passe" styleClass="field-label"/>
                    <StackPane alignment="CENTER_RIGHT">
                        <PasswordField fx:id="passwordField" promptText="8 caractères minimum"
                                       styleClass="auth-field, has-reveal"/>
                        <TextField fx:id="passwordVisible" promptText="8 caractères minimum"
                                   styleClass="auth-field, has-reveal"/>
                        <Button fx:id="togglePassword" text="Afficher" styleClass="btn-reveal"
                                focusTraversable="false" StackPane.alignment="CENTER_RIGHT">
                            <StackPane.margin>
                                <Insets right="6"/>
                            </StackPane.margin>
                        </Button>
                    </StackPane>
                    <ProgressBar fx:id="strengthBar" progress="0" maxWidth="Infinity" styleClass="strength-bar"/>
                    <Label fx:id="strengthLabel" styleClass="strength-label"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Confirmer le mot de passe" styleClass="field-label"/>
                    <PasswordField fx:id="confirmField" promptText="Retapez le mot de passe"
                                   styleClass="auth-field" onAction="#onReset"/>
                </VBox>

                <Button fx:id="resetButton" text="Réinitialiser le mot de passe" styleClass="btn-primary"
                        maxWidth="Infinity" defaultButton="true" onAction="#onReset"/>

                <HBox alignment="CENTER" spacing="16">
                    <Hyperlink text="Je n'ai pas reçu de code" styleClass="auth-link" onAction="#onNoCode"/>
                    <Hyperlink text="Retour à la connexion" styleClass="auth-link" onAction="#onBack"/>
                </HBox>
            </VBox>
        </StackPane>
    </ScrollPane>
</HBox>
