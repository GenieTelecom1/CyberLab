<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cyberlab.controller.QuizController" styleClass="root-pane">
    <center>
        <VBox alignment="CENTER" spacing="20" styleClass="dashboard-content">
            <children>
                <HBox alignment="CENTER_LEFT">
                    <Label fx:id="progressLabel" text="CYBERLAB / QUIZ • Question 1 / 8" styleClass="section-label"/>
                </HBox>
                <VBox alignment="CENTER" spacing="25" styleClass="card" VBox.vgrow="ALWAYS" maxWidth="750">
                    <children>
                        <Label fx:id="questionLabel" text="Chargement de la question..." wrapText="true" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-alignment: center;"/>
                        <VBox spacing="12" maxWidth="650">
                            <Button fx:id="btnA" maxWidth="Infinity" onAction="#handleReponse" text="A • Choix A" styleClass="pill-outline" alignment="BASELINE_LEFT"/>
                            <Button fx:id="btnB" maxWidth="Infinity" onAction="#handleReponse" text="B • Choix B" styleClass="pill-outline" alignment="BASELINE_LEFT"/>
                            <Button fx:id="btnC" maxWidth="Infinity" onAction="#handleReponse" text="C • Choix C" styleClass="pill-outline" alignment="BASELINE_LEFT"/>
                            <Button fx:id="btnD" maxWidth="Infinity" onAction="#handleReponse" text="D • Choix D" styleClass="pill-outline" alignment="BASELINE_LEFT"/>
                        </VBox>
                        <Button fx:id="btnSuivant" text="Question Suivante →" onAction="#handleSuivant" visible="false" styleClass="btn-cyan"/>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>