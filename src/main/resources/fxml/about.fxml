<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<!-- Pas de fx:controller : MainShellController est injecté via loader.setController(this) -->
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="about-scroll">
    <content>
        <VBox spacing="26" styleClass="about-root">
            <padding><Insets top="10" right="40" bottom="40" left="24"/></padding>

            <!-- HERO -->
            <HBox styleClass="home-hero" spacing="20" alignment="CENTER_LEFT">
                <VBox spacing="10" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
                    <Label text="Bienvenue sur CyberLab" styleClass="home-pill"/>
                    <Label text="Deviens acteur de ta" styleClass="home-title" wrapText="true"/>
                    <Label text="cybersécurité" styleClass="home-title-red"/>
                    <Label wrapText="true" styleClass="about-text"
                           text="Apprends, teste et protège-toi dans un monde numérique de plus en plus connecté."/>
                    <HBox spacing="14">
                        <Button text="Commencer à apprendre" styleClass="home-btn-main" onAction="#onSignup"/>
                        <Button text="Se connecter" styleClass="home-btn-alt" onAction="#onLogin"/>
                    </HBox>
                </VBox>
                <ImageView fitHeight="290" preserveRatio="true" smooth="true">
                    <image><Image url="@../images/hero_shield.png"/></image>
                </ImageView>
            </HBox>

            <!-- CHIFFRES CLÉS -->
            <HBox spacing="16">
                <HBox styleClass="home-stat" spacing="14" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="100">
                    <ImageView fitHeight="56" preserveRatio="true" smooth="true"><image><Image url="@../images/ic_book.png"/></image></ImageView>
                    <VBox spacing="1" HBox.hgrow="ALWAYS"><Label text="6" styleClass="home-stat-value"/><Label text="Cours disponibles" styleClass="about-text-small" wrapText="true"/></VBox>
                    <Label text="→" styleClass="home-round"/>
                </HBox>
                <HBox styleClass="home-stat" spacing="14" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="100">
                    <ImageView fitHeight="56" preserveRatio="true" smooth="true"><image><Image url="@../images/ic_trophy.png"/></image></ImageView>
                    <VBox spacing="1" HBox.hgrow="ALWAYS"><Label text="1 quiz" styleClass="home-stat-value"/><Label text="Par cours, prêt à relever le défi" styleClass="about-text-small" wrapText="true"/></VBox>
                    <Label text="→" styleClass="home-round"/>
                </HBox>
                <HBox styleClass="home-stat" spacing="14" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="100">
                    <ImageView fitHeight="56" preserveRatio="true" smooth="true"><image><Image url="@../images/ic_game.png"/></image></ImageView>
                    <VBox spacing="1" HBox.hgrow="ALWAYS"><Label text="2" styleClass="home-stat-value"/><Label text="Simulations interactives" styleClass="about-text-small" wrapText="true"/></VBox>
                    <Label text="→" styleClass="home-round"/>
                </HBox>
                <HBox styleClass="home-stat" spacing="14" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="100">
                    <ImageView fitHeight="56" preserveRatio="true" smooth="true"><image><Image url="@../images/ic_ai.png"/></image></ImageView>
                    <VBox spacing="1" HBox.hgrow="ALWAYS"><Label text="IA" styleClass="home-stat-value"/><Label text="Ton assistant intelligent" styleClass="about-text-small" wrapText="true"/></VBox>
                    <Label text="→" styleClass="home-round"/>
                </HBox>
            </HBox>

            <Label text="Comment ça marche ?" styleClass="home-section"/>
            <HBox spacing="10" alignment="CENTER">
                <HBox styleClass="home-step" spacing="14" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="100">
                    <Label text="1" styleClass="home-step-num"/>
                    <VBox spacing="2"><Label text="Crée ton compte" styleClass="about-feature-title"/><Label text="C'est rapide et gratuit" styleClass="about-text-small" wrapText="true"/></VBox>
                </HBox>
                <Label text="→" styleClass="home-arrow"/>
                <HBox styleClass="home-step" spacing="14" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="100">
                    <Label text="2" styleClass="home-step-num"/>
                    <VBox spacing="2"><Label text="Apprends" styleClass="about-feature-title"/><Label text="Avec nos cours interactifs" styleClass="about-text-small" wrapText="true"/></VBox>
                </HBox>
                <Label text="→" styleClass="home-arrow"/>
                <HBox styleClass="home-step" spacing="14" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="100">
                    <Label text="3" styleClass="home-step-num"/>
                    <VBox spacing="2"><Label text="Teste-toi" styleClass="about-feature-title"/><Label text="Grâce à nos quiz et simulations" styleClass="about-text-small" wrapText="true"/></VBox>
                </HBox>
            </HBox>

            <HBox alignment="CENTER_LEFT">
                <Label text="Nos cours" styleClass="home-section"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Créer un compte pour y accéder  →" styleClass="home-link" onAction="#onSignup"/>
            </HBox>
            <GridPane hgap="16" vgap="16">
                <columnConstraints>
                    <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="33.34" hgrow="ALWAYS"/>
                </columnConstraints>
                <HBox GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="home-course" spacing="14" alignment="CENTER_LEFT" maxWidth="Infinity">
                    <ImageView fitWidth="118" fitHeight="128" preserveRatio="false" smooth="true">
                        <image><Image url="@../images/course_1.png"/></image>
                    </ImageView>
                    <VBox spacing="5" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
                        <Label text="01" styleClass="home-badge"/>
                        <Label text="Introduction à la cybersécurité" styleClass="home-course-title" wrapText="true"/>
                        <Label text="Découvre les bases de la sécurité informatique." styleClass="about-text-small" wrapText="true"/>
                        <Label text="Menaces • CIA • Bons réflexes" styleClass="about-text-small" wrapText="true"/>
                        <HBox spacing="14" alignment="CENTER_LEFT">
                            <Label text="15 min" styleClass="home-meta"/>
                            <Label text="Facile" styleClass="home-level-easy"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="→" styleClass="home-go" onAction="#onSignup"/>
                        </HBox>
                    </VBox>
                </HBox>
                <HBox GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="home-course" spacing="14" alignment="CENTER_LEFT" maxWidth="Infinity">
                    <ImageView fitWidth="118" fitHeight="128" preserveRatio="false" smooth="true">
                        <image><Image url="@../images/course_2.png"/></image>
                    </ImageView>
                    <VBox spacing="5" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
                        <Label text="02" styleClass="home-badge"/>
                        <Label text="Phishing" styleClass="home-course-title" wrapText="true"/>
                        <Label text="Apprends à reconnaître les tentatives d'hameçonnage." styleClass="about-text-small" wrapText="true"/>
                        <Label text="Définition • Indices • Protection" styleClass="about-text-small" wrapText="true"/>
                        <HBox spacing="14" alignment="CENTER_LEFT">
                            <Label text="20 min" styleClass="home-meta"/>
                            <Label text="Moyen" styleClass="home-level-mid"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="→" styleClass="home-go" onAction="#onSignup"/>
                        </HBox>
                    </VBox>
                </HBox>
                <HBox GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="home-course" spacing="14" alignment="CENTER_LEFT" maxWidth="Infinity">
                    <ImageView fitWidth="118" fitHeight="128" preserveRatio="false" smooth="true">
                        <image><Image url="@../images/course_3.png"/></image>
                    </ImageView>
                    <VBox spacing="5" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
                        <Label text="03" styleClass="home-badge"/>
                        <Label text="Malware" styleClass="home-course-title" wrapText="true"/>
                        <Label text="Comprends les menaces malveillantes et comment te protéger." styleClass="about-text-small" wrapText="true"/>
                        <Label text="Familles • Infiltration • Prévention" styleClass="about-text-small" wrapText="true"/>
                        <HBox spacing="14" alignment="CENTER_LEFT">
                            <Label text="25 min" styleClass="home-meta"/>
                            <Label text="Difficile" styleClass="home-level-hard"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="→" styleClass="home-go" onAction="#onSignup"/>
                        </HBox>
                    </VBox>
                </HBox>
                <HBox GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="home-course" spacing="14" alignment="CENTER_LEFT" maxWidth="Infinity">
                    <ImageView fitWidth="118" fitHeight="128" preserveRatio="false" smooth="true">
                        <image><Image url="@../images/course_4.png"/></image>
                    </ImageView>
                    <VBox spacing="5" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
                        <Label text="04" styleClass="home-badge"/>
                        <Label text="Social Engineering" styleClass="home-course-title" wrapText="true"/>
                        <Label text="Comment les attaquants manipulent les personnes." styleClass="about-text-small" wrapText="true"/>
                        <Label text="Techniques • Scénarios • Défense" styleClass="about-text-small" wrapText="true"/>
                        <HBox spacing="14" alignment="CENTER_LEFT">
                            <Label text="20 min" styleClass="home-meta"/>
                            <Label text="Moyen" styleClass="home-level-mid"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="→" styleClass="home-go" onAction="#onSignup"/>
                        </HBox>
                    </VBox>
                </HBox>
                <HBox GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="home-course" spacing="14" alignment="CENTER_LEFT" maxWidth="Infinity">
                    <ImageView fitWidth="118" fitHeight="128" preserveRatio="false" smooth="true">
                        <image><Image url="@../images/course_5.png"/></image>
                    </ImageView>
                    <VBox spacing="5" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
                        <Label text="05" styleClass="home-badge"/>
                        <Label text="Network Security" styleClass="home-course-title" wrapText="true"/>
                        <Label text="Réseaux, pare-feu, VPN et chiffrement." styleClass="about-text-small" wrapText="true"/>
                        <Label text="Réseau • Pare-feu/VPN • Chiffrement" styleClass="about-text-small" wrapText="true"/>
                        <HBox spacing="14" alignment="CENTER_LEFT">
                            <Label text="30 min" styleClass="home-meta"/>
                            <Label text="Difficile" styleClass="home-level-hard"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="→" styleClass="home-go" onAction="#onSignup"/>
                        </HBox>
                    </VBox>
                </HBox>
                <HBox GridPane.columnIndex="2" GridPane.rowIndex="1" styleClass="home-course" spacing="14" alignment="CENTER_LEFT" maxWidth="Infinity">
                    <ImageView fitWidth="118" fitHeight="128" preserveRatio="false" smooth="true">
                        <image><Image url="@../images/course_6.png"/></image>
                    </ImageView>
                    <VBox spacing="5" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
                        <Label text="06" styleClass="home-badge"/>
                        <Label text="Password Security" styleClass="home-course-title" wrapText="true"/>
                        <Label text="Créer, protéger et gérer ses mots de passe." styleClass="about-text-small" wrapText="true"/>
                        <Label text="Bon mot de passe • Gestionnaire • 2FA" styleClass="about-text-small" wrapText="true"/>
                        <HBox spacing="14" alignment="CENTER_LEFT">
                            <Label text="15 min" styleClass="home-meta"/>
                            <Label text="Facile" styleClass="home-level-easy"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="→" styleClass="home-go" onAction="#onSignup"/>
                        </HBox>
                    </VBox>
                </HBox>
            </GridPane>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Et bien plus, avec ton compte" styleClass="home-section"/>
                <Label text="INCLUS" styleClass="about-tag"/>
            </HBox>
            <HBox spacing="16">
                <VBox styleClass="home-feature" spacing="7" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="100">
                    <Label text="?" styleClass="home-icon"/>
                    <Label text="Quiz" styleClass="about-feature-title"/>
                    <Label text="Un quiz par cours" styleClass="about-text-small" wrapText="true"/>
                    <Label text="✓  Score et correction" styleClass="about-part" wrapText="true"/>
                    <Label text="✓  Historique de tes résultats" styleClass="about-part" wrapText="true"/>
                </VBox>
                <VBox styleClass="home-feature" spacing="7" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="100">
                    <Label text="!" styleClass="home-icon"/>
                    <Label text="Simulations" styleClass="about-feature-title"/>
                    <Label text="Cas concrets" styleClass="about-text-small" wrapText="true"/>
                    <Label text="✓  Détecteur de phishing" styleClass="about-part" wrapText="true"/>
                    <Label text="✓  Testeur de mot de passe" styleClass="about-part" wrapText="true"/>
                </VBox>
                <VBox styleClass="home-feature" spacing="7" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="100">
                    <Label text="IA" styleClass="home-icon"/>
                    <Label text="Assistant IA" styleClass="about-feature-title"/>
                    <Label text="Pose tes questions" styleClass="about-text-small" wrapText="true"/>
                    <Label text="✓  Répond à partir des cours" styleClass="about-part" wrapText="true"/>
                    <Label text="✓  Explications simples" styleClass="about-part" wrapText="true"/>
                </VBox>
                <VBox styleClass="home-feature" spacing="7" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="100">
                    <Label text="#" styleClass="home-icon"/>
                    <Label text="Classement" styleClass="about-feature-title"/>
                    <Label text="Mesure-toi aux autres" styleClass="about-text-small" wrapText="true"/>
                    <Label text="✓  Points et rang" styleClass="about-part" wrapText="true"/>
                    <Label text="✓  Progression par cours" styleClass="about-part" wrapText="true"/>
                </VBox>
            </HBox>

            <HBox styleClass="home-cta" spacing="20" alignment="CENTER_LEFT">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Prêt à te lancer dans la cybersécurité ?" styleClass="home-cta-title"/>
                    <Label text="Crée ton compte et débloque les cours, quiz, simulations et l'assistant IA." styleClass="home-cta-text" wrapText="true"/>
                </VBox>
                <Button text="Voir les offres" styleClass="home-cta-btn" onAction="#onSignup"/>
                <Button text="Se connecter" styleClass="home-cta-btn2" onAction="#onLogin"/>
            </HBox>
        </VBox>
    </content>
</ScrollPane>
