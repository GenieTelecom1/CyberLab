<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      styleClass="auth-root" fx:controller="com.cyberlab.controller.VerifyController">
    <stylesheets>
        <URL value="@../css/auth.css"/>
    </stylesheets>

    <fx:include source="auth-hero.fxml"/>

    <ScrollPane HBox.hgrow="ALWAYS" fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER"
                styleClass="auth-scroll">
        <StackPane styleClass="auth-right">
            <VBox styleClass="auth-card" prefWidth="440" maxWidth="440" maxHeight="-Infinity" spacing="16">
                <HBox>
                    <Label text="VÉRIFICATION E-MAIL" styleClass="badge"/>
                </HBox>
                <Label text="Vérifiez votre adresse" styleClass="auth-title"/>
                <Label fx:id="infoLabel" styleClass="auth-subtitle" wrapText="true"/>

                <Label fx:id="successLabel" styleClass="success-label" maxWidth="Infinity" wrapText="true"/>
                <Label fx:id="errorLabel" styleClass="error-label" maxWidth="Infinity" wrapText="true"/>

                <VBox spacing="6">
                    <Label text="Code de vérification" styleClass="field-label"/>
                    <TextField fx:id="codeField" promptText="000000" styleClass="auth-field, code-field"
                               onAction="#onVerify"/>
                    <Label text="Le code expire au bout de 15 minutes. Pensez à regarder dans vos courriers indésirables."
                           styleClass="field-hint" wrapText="true"/>
                </VBox>

                <Button fx:id="verifyButton" text="Vérifier mon e-mail" styleClass="btn-primary"
                        maxWidth="Infinity" defaultButton="true" onAction="#onVerify"/>

                <HBox alignment="CENTER" spacing="16">
                    <Hyperlink fx:id="resendLink" text="Renvoyer le code" styleClass="auth-link" onAction="#onResend"/>
                    <Hyperlink text="Retour à la connexion" styleClass="auth-link" onAction="#onBack"/>
                </HBox>
            </VBox>
        </StackPane>
    </ScrollPane>
</HBox>
