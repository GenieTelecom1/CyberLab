<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cyberlab.controller.MainShellController" styleClass="root-pane">
    <left>
        <!-- Les boutons de navigation doivent rester enfants DIRECTS de ce VBox (le contrôleur le masque pour les visiteurs). -->
        <VBox styleClass="sidebar" prefWidth="116" minWidth="116" maxWidth="116" spacing="10">
            <Button fx:id="navDashboard" text="Accueil" styleClass="nav-button" contentDisplay="TOP" maxWidth="Infinity" onAction="#goDashboard"/>
            <Button fx:id="navCourses" text="Cours" styleClass="nav-button" contentDisplay="TOP" maxWidth="Infinity" onAction="#goCourses"/>
            <Button fx:id="navQuiz" text="Quiz" styleClass="nav-button" contentDisplay="TOP" maxWidth="Infinity" onAction="#goQuiz"/>
            <Button fx:id="navSimulations" text="Simulations" styleClass="nav-button" contentDisplay="TOP" maxWidth="Infinity" onAction="#goSimulations"/>
            <Button fx:id="navLeaderboard" text="Classement" styleClass="nav-button" contentDisplay="TOP" maxWidth="Infinity" onAction="#goLeaderboard"/>
            <Button fx:id="navChatbot" text="Assistant IA" styleClass="nav-button" contentDisplay="TOP" maxWidth="Infinity" onAction="#goChatbot"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button fx:id="navLogout" text="Déconnexion" styleClass="nav-button, nav-logout" contentDisplay="TOP" maxWidth="Infinity" onAction="#logout"/>
        </VBox>
    </left>
    <center>
        <BorderPane>
            <top>
                <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="14">
                    <ImageView fitHeight="54" preserveRatio="true" smooth="true">
                        <image><Image url="@../images/logo_cyberlab.png"/></image>
                    </ImageView>
                    <HBox spacing="0" alignment="CENTER_LEFT">
                        <Label text="Cyber" styleClass="brand-a"/>
                        <Label text="Lab" styleClass="brand-b"/>
                    </HBox>
                    <Label fx:id="pageTitle" text="Accueil" styleClass="page-title"/>
                    <TextField fx:id="searchField"
                               promptText="Rechercher des cours, labs, utilisateurs…"
                               styleClass="search-field"
                               HBox.hgrow="ALWAYS" maxWidth="460"
                               onAction="#onSearch"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="loginButton"  text="Se connecter" styleClass="btn-login"  onAction="#onLogin"/>
                    <Button fx:id="signupButton" text="S'inscrire"   styleClass="btn-signup" onAction="#onSignup"/>
                    <Label fx:id="userLabel" styleClass="muted-small" visible="false" managed="false"/>
                    <Button fx:id="logoutButton" text="Déconnexion" styleClass="btn-login" onAction="#logout" visible="false" managed="false"/>
                </HBox>
            </top>
            <center>
                <StackPane fx:id="contentArea"/>
            </center>
        </BorderPane>
    </center>
</BorderPane>
