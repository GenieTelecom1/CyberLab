<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.cyberlab.controller.CourseController"
            styleClass="cl-root">

    <left>
        <VBox prefWidth="300" spacing="10" styleClass="cl-side" BorderPane.alignment="CENTER">
            <BorderPane.margin><Insets top="8" right="8" bottom="16" left="10"/></BorderPane.margin>
            <padding>
                <Insets top="20" right="15" bottom="20" left="15"/>
            </padding>

            <Label text="Liste des cours" styleClass="cl-title"/>

            <!-- Les 6 cours -->
            <ListView fx:id="courseList" prefHeight="236" minHeight="236" maxHeight="236"/>

            <!-- Les parties (## du Markdown) du cours sélectionné -->
            <Label text="Parties du cours" styleClass="cl-sub">
                <padding>
                    <Insets top="8" right="0" bottom="0" left="0"/>
                </padding>
            </Label>

            <ListView fx:id="sectionList" VBox.vgrow="ALWAYS"/>

            <Label text="Votre progression" styleClass="cl-sub"/>

            <ProgressBar fx:id="progressBar" prefWidth="270" progress="0"/>

            <Label fx:id="progressLabel" text="0 / 0 cours terminés"/>

        </VBox>
    </left>

    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="12" right="25" bottom="20" left="25"/>
            </padding>

            <Label fx:id="titleLabel" text="Sélectionnez un cours" styleClass="cl-heading"/>

            <WebView fx:id="contentView" VBox.vgrow="ALWAYS"/>

            <Label fx:id="statusLabel" text="" styleClass="cl-status"/>

            <HBox spacing="12" alignment="CENTER_RIGHT">

                <Button fx:id="prevButton" text="← Précédent" styleClass="secondary-button" onAction="#onPrevious"/>

                <Button fx:id="quizButton" text="Passer le quiz du cours" styleClass="btn-cyan" onAction="#onQuiz"/>

                <Button fx:id="completeButton" text="Marquer comme terminé" styleClass="violet-button" onAction="#onComplete"/>

                <Button fx:id="nextButton" text="Suivant →" styleClass="secondary-button" onAction="#onNext"/>

            </HBox>

        </VBox>
    </center>

</BorderPane>
