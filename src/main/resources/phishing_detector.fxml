<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox xmlns="[suspicious link removed]" xmlns:fx="[suspicious link removed]" prefHeight="700.0" prefWidth="900.0" spacing="20.0" style="-fx-background-color: #F8F9FA;" fx:controller="com.example.demo1.SimulationController">
    <padding>
        <Insets bottom="25.0" left="30.0" right="30.0" top="25.0" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="50.0" spacing="20.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 8, 0, 0, 2);">
            <padding>
                <Insets left="20.0" right="20.0" />
            </padding>
            <children>
                <Label text="Simulation : Phishing Detector" style="-fx-font-weight: bold;" textFill="#2C3E50">
                    <font>
                        <Font size="20.0" />
                    </font>
                </Label>
                <HBox HBox.hgrow="ALWAYS" />
                <Label fx:id="lblEmailCounter" style="-fx-background-color: #E8F4F8; -fx-padding: 6 14; -fx-background-radius: 15; -fx-font-weight: bold;" text="Email 1 sur 8" textFill="#2980B9">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <Label fx:id="lblScore" style="-fx-background-color: #FEF9E7; -fx-padding: 6 14; -fx-background-radius: 15; -fx-font-weight: bold;" text="Score : 0 / 0" textFill="#D68910">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
            </children>
        </HBox>

        <VBox spacing="12.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-border-color: #E0E0E0; -fx-border-radius: 10;" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label style="-fx-font-weight: bold;" text="De :" textFill="#7F8C8D">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                        <Label fx:id="lblExpediteur" style="-fx-font-weight: bold;" text="securite@service-paiement.com" textFill="#2C3E50">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label style="-fx-font-weight: bold;" text="Objet :" textFill="#7F8C8D">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                        <Label fx:id="lblObjet" style="-fx-font-weight: bold;" text="URGENT : Votre compte a été restreint" textFill="#2C3E50">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>

                <HBox prefHeight="1.0" style="-fx-background-color: #ECF0F1;" />

                <TextArea fx:id="txtCorps" editable="false" wrapText="true" VBox.vgrow="ALWAYS" style="-fx-control-inner-background: #FAFAFA; -fx-font-size: 14px; -fx-border-color: transparent;" text="Cher utilisateur, Une activité inhabituelle a été détectée sur votre compte..." />
            </children>
        </VBox>

        <HBox alignment="CENTER" spacing="30.0">
            <children>
                <Button fx:id="btnLegitime" onAction="#handleLegitimeAction" prefHeight="45.0" prefWidth="180.0" style="-fx-background-color: #2ECC71; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px; -fx-background-radius: 8; -fx-cursor: hand;" text="✓ Légitime" />
                <Button fx:id="btnFrauduleux" onAction="#handleFrauduleuxAction" prefHeight="45.0" prefWidth="180.0" style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px; -fx-background-radius: 8; -fx-cursor: hand;" text="⚠ Frauduleux" />
            </children>
        </HBox>

        <VBox fx:id="paneFeedback" managed="false" visible="false" spacing="12.0" style="-fx-background-color: #EAFAF1; -fx-background-radius: 10; -fx-border-color: #2ECC71; -fx-border-radius: 10;">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <children>
                <Label fx:id="lblResultat" style="-fx-font-weight: bold;" text="Résultat : Bonne réponse !" textFill="#1E8449">
                    <font>
                        <Font size="15.0" />
                    </font>
                </Label>

                <VBox fx:id="vboxIndices" spacing="4.0">
                    <children>
                        <Label style="-fx-font-weight: bold;" text="Indices suspects détectés :" textFill="#2C3E50" />
                    </children>
                </VBox>

                <Label fx:id="lblConseilSecurite" wrapText="true" text="À retenir : Vérifiez toujours l'orthographe du domaine de l'expéditeur." textFill="#34495E">
                    <font>
                        <Font size="13.0" />
                    </font>
                </Label>

                <HBox alignment="CENTER_RIGHT">
                    <children>
                        <Button fx:id="btnSuivant" onAction="#handleSuivantAction" prefHeight="35.0" prefWidth="140.0" style="-fx-background-color: #3498DB; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Email suivant ➔" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>